# Copy to .env and fill in real values. Never commit the real .env.

# --- Environment ---
PORT=10000
# development | production — required by backend/utils/assertDevDatabase.js
# to block destructive scripts (seed_activity.js, migration scripts) from
# running unless this is explicitly "development". See IME-21.
DB_ENV=development

# --- Database ---
MONGO_URL=
DBPASS=

# --- Auth ---
JWT_SECRET=

# --- URLs ---
BACKEND_URL=
FRONTEND_URL=
CLIENT_BASE_URL=

# --- Cloudinary (media uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# --- SendGrid (email) ---
SENDGRID_API_KEY=
FROM_EMAIL=
SENDGRID_RESET_PASSWORD_TEMPLATEID=
SENDGRID_EMAIL_VERIFICATION=

# --- AI ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Morning (payments) ---
MORNING_API_KEY=
MORNING_API_SECRET=
MORNING_WEBHOOK_URL=

# --- Pricing (subscription tiers) ---
PRICE_ESSENTIAL=
PRICE_ADVANCE=
PRICE_PRO=

# --- Discord (internal notifications) ---
DISCORD_ACTIVITY_WEBHOOK_URL=
DISCORD_ERRORS_WEBHOOK_URL=
DISCORD_TICKET_WEBHOOK_URL=

# --- Monitoring ---
# Sentry project DSN. Leave empty to disable error tracking entirely
# (backend/utils/sentry.js no-ops without it). See IME-9.
SENTRY_DSN=
